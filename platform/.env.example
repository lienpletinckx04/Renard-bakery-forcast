# Voorbeeld. Kopieer naar .env.local en vul in. .env.local is gitignored.
#
# Hier staan geen echte waarden, en dat is geen slordigheid: een wachtwoord of
# een sessiesleutel in de repo is even lek als een wachtwoord in de code.

# Ondertekent de sessiecookie. 32 willekeurige bytes, base64url:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Wisselt deze waarde, dan zijn alle lopende sessies ongeldig. Dat is meteen
# de noodrem als er ooit iets misgaat.
PLATFORM_SESSIE_SLEUTEL=

# Welke laag het wachtwoord toetst: "omgeving" (standaard, de lijst hieronder)
# of "supabase" (blok 12; vergt S12 — zelfregistratie uit — en S13 — de
# gebruikerslijst met `rol` in app_metadata: beheerder of lezer). De sessie
# en de cookie blijven in beide gevallen dezelfde, van ons en ondertekend.
AUTH_BRON=omgeving

# Eén of meer gebruikers, gescheiden door komma's:
#   naam:rol:<zout>.<afdruk>
# (het scheidingsteken tussen zout en afdruk is een punt: een `$` zou door de
# variabele-expansie van de env-loader stilletjes worden weggeknipt)
# rol is `beheerder` of `lezer` (de rol heette tot 18 aug 2026 `bekijker`;
# scripts/maak_gebruiker.mjs weigert die oude naam, dus wie dit voorbeeld
# volgde kreeg een foutmelding). Een regel maken (het script staat in de
# repo-root, niet in `platform/`; onderstaand pad geldt vanuit `platform/`):
#   node ../scripts/maak_gebruiker.mjs <naam> <rol>   (wachtwoord via stdin)
# Is deze variabele leeg, dan komt er niemand binnen. Dat is met opzet: geen
# gebruikers betekent geen toegang, en niet een achterdeur die openstaat.
PLATFORM_GEBRUIKERS=

# --- Contract uit de database (O13) -----------------------------------------
# Waar het platform het contract leest. Leeg of `bestand` (de standaard):
# platform/contract/*.json, zoals altijd. `db`: de tabel contract_antwoord
# (migratie 006, gevuld door de nachtelijke sync of `make db-contract`) —
# vergt NEXT_PUBLIC_SUPABASE_URL en SUPABASE_SECRET_KEY in de serveromgeving.
# Op Vercel gaat de vlag samen met die twee variabelen; SUPABASE_DB_URL blijft
# daar weg (stack.md, "Waar de secrets staan").
CONTRACT_BRON=

# Projecturl, `https://<ref>.supabase.co`. Mag publiek.
NEXT_PUBLIC_SUPABASE_URL=

# De `sb_publishable_…`-sleutel. Mag publiek: hij komt hoe dan ook in de
# JavaScript-bundel terecht, want alles met `NEXT_PUBLIC_` wordt erin gebakken.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# De `sb_secret_…`-sleutel. NOOIT in de browser, nooit met `NEXT_PUBLIC_`.
# Sinds 18 aug 2026 heeft die sleutel één servertaak: met CONTRACT_BRON=db
# leest het platform de contractantwoorden ermee uit contract_antwoord via
# PostgREST (zie platform/lib/contract-bron.ts). Zonder die vlag is hij
# nergens voor nodig; leeg laten tot het tegendeel blijkt — een sleutel die
# er niet staat, kan niet lekken.
SUPABASE_SECRET_KEY=
